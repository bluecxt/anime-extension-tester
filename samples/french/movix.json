{
  "name": "Movix Suite",
  "extension": "eu.kanade.tachiyomi.animeextension.fr.movix.MovixFactory",
  "lang": "fr",
  "tests": [
    {
      "name": "Movix Popular Catalog Check",
      "target": "GET_POPULAR",
      "input": {
        "page": 1
      },
      "contract": {
        "minCount": 1,
        "requireNonBlankFields": [
          "title",
          "url"
        ]
      }
    },
    {
      "name": "Movix Search 'Piece' Check",
      "target": "GET_SEARCH",
      "input": {
        "page": 1,
        "query": "Piece"
      },
      "contract": {
        "minCount": 1
      }
    }
  ]
}