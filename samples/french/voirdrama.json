{
  "name": "VoirDrama Suite",
  "extension": "eu.kanade.tachiyomi.animeextension.fr.voirdrama.VoirDrama",
  "lang": "fr",
  "tests": [
    {
      "name": "VoirDrama Popular Catalog Check",
      "target": "GET_POPULAR",
      "input": {
        "page": 1
      },
      "contract": {
        "minCount": 1,
        "requireNonBlankFields": [
          "title",
          "url"
        ]
      }
    },
    {
      "name": "VoirDrama Search 'Love' Check",
      "target": "GET_SEARCH",
      "input": {
        "page": 1,
        "query": "Love"
      },
      "contract": {
        "minCount": 1
      }
    }
  ]
}