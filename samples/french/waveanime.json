{
  "name": "WaveAnime Suite",
  "extension": "eu.kanade.tachiyomi.animeextension.fr.waveanime.WaveAnime",
  "lang": "fr",
  "tests": [
    {
      "name": "WaveAnime Popular Catalog Check",
      "target": "GET_POPULAR",
      "input": {
        "page": 1
      },
      "contract": {
        "minCount": 1,
        "requireNonBlankFields": [
          "title",
          "url"
        ]
      }
    },
    {
      "name": "WaveAnime Search 'Piece' Check",
      "target": "GET_SEARCH",
      "input": {
        "page": 1,
        "query": "Piece"
      },
      "contract": {
        "minCount": 1
      }
    }
  ]
}