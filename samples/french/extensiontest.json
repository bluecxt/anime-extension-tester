{
  "name": "Extension-Test Suite",
  "extension": "eu.kanade.tachiyomi.animeextension.fr.extensiontest.ExtensionTest",
  "lang": "fr",
  "tests": [
    {
      "name": "Extension-Test Popular Catalog Check",
      "target": "GET_POPULAR",
      "input": {
        "page": 1
      },
      "contract": {
        "minCount": 1,
        "requireNonBlankFields": [
          "title",
          "url"
        ]
      }
    },
    {
      "name": "Extension-Test Search 'Test' Check",
      "target": "GET_SEARCH",
      "input": {
        "page": 1,
        "query": "Test"
      },
      "contract": {
        "minCount": 1
      }
    }
  ]
}